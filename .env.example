# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and must never be committed.

# Hugging Face access token, required to download Llama 3.1 8B.
# Create one at https://huggingface.co/settings/tokens (read scope is enough)
# and request access to meta-llama/Llama-3.1-8B-Instruct.
HF_TOKEN=your_huggingface_token_here

# Optional: OpenAI API key, only needed if you switch the Diagnosis Agent
# to the GPT fallback path in core/llm_wrapper.py.
OPENAI_API_KEY=your_openai_key_here
