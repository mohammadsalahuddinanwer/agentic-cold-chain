# ─────────────────────────────────────────────────────────────────────────
# Secrets — never commit these
# ─────────────────────────────────────────────────────────────────────────
.env
.env.local
*.key
*.pem

# ─────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
dist/
venv/
.venv/
env/
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────────────────
# Generated training data
#
# cold_chain_X.npy is ~324 MB, well over GitHub's 100 MB per-file limit.
# These arrays are reproducible: run
#     python generate_cold_chain_training_data.py
# to regenerate the whole of data/synthetic/ from the three raw datasets
# in data/raw/, which ARE tracked.
# ─────────────────────────────────────────────────────────────────────────
data/synthetic/*.npy
data/synthetic/cold_chain_metadata.csv
data/processed/

# ─────────────────────────────────────────────────────────────────────────
# Model checkpoints — regenerated by train_on_synthetic.py
# Track these with Git LFS instead if you want the trained Monitor shipped.
# ─────────────────────────────────────────────────────────────────────────
outputs/checkpoints/*.pt
outputs/logs/

# ─────────────────────────────────────────────────────────────────────────
# Editor / OS noise
# ─────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
